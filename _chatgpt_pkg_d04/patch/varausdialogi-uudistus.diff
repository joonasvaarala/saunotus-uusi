+      const item = lines.find((x) => x.key === key && x.lang === lang);
+      assert.equal(item?.text, texts[lang], `${key} ${lang}`);
+      assert.deepEqual(item?.placeholders,
+        [...texts[lang].matchAll(/\{\{var:[^}]+\}\}/g)].map((m) => m[0]));
+    }
+  }
+});
