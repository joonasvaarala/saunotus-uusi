# Tuotantosivusto https://saunotus.fi. Vain Supabase PROD (sxbofnuisemspgquoxyv).
# Julkinen publishable-avain. Salaisuuksia ei tähän.
# Lataa: npm run build:prod   tai   bash scripts/build-site.sh prod
# Kuvamuunnos on oletuksena päällä. Älä lisää IMAGE_TRANSFORMS-riviä, ellei sitä haluta pois.
# dist/ ladataan tuotantopalvelimelle SFTP:llä. Tätä ei julkaise GitHub Actions.
SITE_ENV=prod
# Tuotantobuild ei saa kirjoittaa testiympäristön banneria distiin. Build keskeytyy, jos tämä on on.
TEST_ENV_BANNER=off
SITE_URL=https://saunotus.fi
BOOKING_SUPABASE_URL=https://sxbofnuisemspgquoxyv.supabase.co
BOOKING_ANON_KEY=sb_publishable_LZFhBH9bMAe8Q8uDI70bvQ_1cSVHCih
