  {
    "key": "ui.admin.customer_message.lead",
    "lang": "en",
    "text": "Choose one day or a date range and the products. The message goes to people who booked a selected product on that day (reservation start date in Helsinki) or bought it (order payment date in Helsinki). Each customer receives one message. Cancelled reservations, expired holds and the waitlist are left out. Marketing consent is not required. Preview before sending. Each person receives the message in their order language.",
    "class": "normal",
    "kind": "plain",
    "max_len": 500,
    "placeholders": [],
    "reason": "booking_257: hallinnan Viesti asiakkaalle"
  },
  {
    "key": "ui.admin.customer_message.lead",
    "lang": "fi",
    "text": "Valitse yksi päivä tai aikaväli ja tuotteet. Viesti lähtee niille, jotka ovat varanneet valitun tuotteen kyseiselle päivälle (varauksen alkupäivä Helsingissä) tai ostaneet sen (tilauksen maksupäivä Helsingissä). Sama asiakas saa yhden viestin. Peruutetut varaukset, vanhentuneet pidot ja jonotuslista jäävät pois. Markkinointilupaa ei tarvita. Esikatsele ennen lähetystä. Jokainen saa viestin tilauksen kielellä.",
    "class": "normal",
    "kind": "plain",
    "max_len": 500,
    "placeholders": [],
    "reason": "booking_257: hallinnan Viesti asiakkaalle"
  },
